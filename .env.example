ZEUS_ENV=development
# SQLite path, or a postgresql:// URL to use Postgres instead.
ZEUS_DATABASE_PATH=/data/zeus.sqlite3
ZEUS_AUTH_MODE=development
ZEUS_ALLOWED_ORIGINS=*

# Speech-to-text. Modes: disabled | openai_compatible | deepgram (windowed) | deepgram_live (streamed).
# ZEUS_STT_API_KEY is server-side only and is never sent to the mobile app.
# ZEUS_STT_MODEL: "whisper-1" for openai_compatible, "nova-2" (or similar) for deepgram / deepgram_live.
ZEUS_STT_MODE=disabled
ZEUS_STT_ENDPOINT=http://host.docker.internal:8001/v1/audio/transcriptions
ZEUS_STT_API_KEY=
ZEUS_STT_MODEL=whisper-1
# Only used by "deepgram" (windowed) mode; deepgram_live streams continuously instead.
ZEUS_STT_WINDOW_SECONDS=2.0

# Vision. Modes: local_only | http (private adapter) | openai (room/kitchen classification).
ZEUS_VISION_MODE=local_only
ZEUS_VISION_ENDPOINT=http://host.docker.internal:8002/v1/analyze
ZEUS_VISION_API_KEY=
ZEUS_VISION_MODEL=gpt-4o-mini

# Pillar 9 adapter. "mock" creates drafts locally; "http" calls an approved internal API.
ZEUS_PILLAR9_MODE=mock
ZEUS_PILLAR9_BASE_URL=
ZEUS_PILLAR9_API_KEY=
ZEUS_PILLAR9_TIMEOUT_SECONDS=15
